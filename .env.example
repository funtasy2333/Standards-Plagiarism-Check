# ==============================================================================
# Standards Plagiarism Check - Remote OCR Environment Configuration
# ==============================================================================

# Default remote OCR engine: "deepseek" or "paddleocr"
STD_CHECK_DEFAULT_OCR_ENGINE=deepseek

# Workspace & OCR cache directory
STD_CHECK_CACHE_DIR=.std_check_cache

# ------------------------------------------------------------------------------
# 1. DeepSeek OCR API (https://api-docs.deepseek.com/zh-cn/guides/ocr)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_OCR_API_URL=https://api.deepseek.com/v1/tools/ocr
# "text_recognition" (direct text for clean docx/pptx, page OCR for PDF/img)
# or "rich_layout_recognition" (page-by-page layout OCR for all files)
DEEPSEEK_OCR_PURPOSE=text_recognition
DEEPSEEK_OCR_TIMEOUT_SECONDS=180

# ------------------------------------------------------------------------------
# 2. Baidu PaddleOCR (https://aistudio.baidu.com/paddleocr)
# ------------------------------------------------------------------------------
# Mode: "aistudio_api" (HTTP REST API) or "mcp" (connect to paddleocr_mcp)
PADDLEOCR_MODE=aistudio_api

# --- Mode A: AI Studio / Qianfan / Self-hosted HTTP API ---
PADDLEOCR_API_URL=
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_TIMEOUT_SECONDS=180

# --- Mode B: PaddleOCR MCP Client ---
# Transport: "stdio" or "streamable_http"
PADDLEOCR_MCP_TRANSPORT=stdio
PADDLEOCR_MCP_COMMAND=paddleocr_mcp
# e.g. PP-StructureV3 or PaddleOCR-VL-1.6
PADDLEOCR_MCP_MODEL=PP-StructureV3
# "aistudio", "qianfan", "self_hosted", or "local"
PADDLEOCR_MCP_SOURCE=aistudio
PADDLEOCR_MCP_SERVER_URL=
# Tool name exposed by paddleocr_mcp: "pp_structurev3", "paddleocr_vl", or "ocr"
PADDLEOCR_MCP_TOOL_NAME=pp_structurev3

# Optional explicit path to LibreOffice executable for Word -> PDF conversion
# when using Baidu PaddleOCR on .doc/.docx files
LIBREOFFICE_PATH=
